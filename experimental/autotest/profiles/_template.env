# Copy this to <yourapp>.env and fill in. Only PKG is strictly required.
#
# PKG        installed (patched) package name.                          [required]
PKG=com.example.app
# ACT        explicit launch component "pkg/activity". Leave unset to let monkey
#            resolve the launcher activity. Needed only for deep-link launches.
#ACT=com.example.app/.MainActivity
# LAUNCH     "monkey" (open from launcher) OR a deep-link URL passed to
#            `am start -a android.intent.action.VIEW -d <URL>`. Deep-linking is
#            the ONLY safe way to select specific content without blind nav — but
#            note many apps' deep links open a details page and DON'T auto-play.
LAUNCH=monkey
# RESUME_KEYS space-separated keyevents (without the KEYCODE_ prefix) that resume
#            a known-good item from the app's landing screen. The default assumes
#            a Continue-Watching tile is focused at launch. NEVER add open-ended
#            DPAD_DOWN/RIGHT sweeps — you can't see the screen to know what you hit.
RESUME_KEYS="DPAD_CENTER DPAD_CENTER"
# ARMED_RE   logcat regex proving the patch self-applied at launch. Leave empty if
#            the patch has no launch-time log signal (the arm check is skipped).
ARMED_RE=""
# ORACLE_RE  logcat regex for the app's ad/behavior oracle line (e.g. a marker your
#            patch logs). Leave empty if none; the report falls back to playback
#            continuity + error scan.
ORACLE_RE=""
# ORACLE_BASELINE_RE  subset of ORACLE_RE lines meaning "nothing happened" (server
#            empty-fill, idle) — filtered out of the report so only real events show.
ORACLE_BASELINE_RE=""
# ERROR_RE   crash/ANR/playback-error regex. A sensible default is applied if unset:
#            "FATAL|ANR in <PKG>|SIGABRT|SIGSEGV|has died".
#ERROR_RE="FATAL|SIGABRT|SIGSEGV|has died.*app|ExoPlaybackException"
