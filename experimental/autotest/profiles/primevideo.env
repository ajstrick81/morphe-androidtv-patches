# Prime Video (Android TV, patched) — autotest profile.
# Ads are stripped by a native hook (libpvhook.so); there is no self-stamping
# "KILLMARK" oracle like Netflix's. So this profile validates PLAYBACK CONTINUITY
# + NO ERRORS under stress, and (optionally) counts ad-related log lines.
#
# NOTE: PV is NOT a clone — it replaces/updates the app in place, package
# com.amazon.amazonvideo.livingroom. Resume-from-Continue-Watching is the safe
# known-good entry (row 0 tile). Confirm the resume keys land on a real title on
# your device's home layout; adjust RESUME_KEYS if your first tile isn't playable.
PKG=com.amazon.amazonvideo.livingroom
LAUNCH=monkey
RESUME_KEYS="DPAD_CENTER DPAD_CENTER"
# PV's native MPB player publishes a MediaSession STATE but pins position at 0,
# so track PLAYING/PAUSED state instead of an advancing position.
# ⚠️ KNOWN LIMITATION (measured 2026-08-08): PV's MediaSession is UNRELIABLE — it
# briefly reports state=PLAYING(3) position=0 and then drops the PlaybackState
# entirely while video keeps playing (video renders on a BLAST SurfaceView, not a
# tracked view tree). So even state-probe attach can miss an actively-playing PV.
# For dependable PV validation, instrument libpvhook to log a marker and set
# ORACLE_RE to it (a real self-stamp, like Netflix's KILLMARK), rather than
# relying on media_session. See docs/AUTONOMOUS_APP_TESTING.md.
PLAYBACK_PROBE=state
# libpvhook self-stamps at load (JNI_OnLoad). Confirms the ad-strip .so is in the app.
ARMED_RE="pvhook loaded"
# Self-stamp oracle (tag PVNativeHook): PVKILL fires each time an ad is removed
# (path=movie blanked=x/y | path=tv ads=x); PVOBS is the periodic running total.
ORACLE_RE="PV(KILL|OBS) [^\r]*"
# "Nothing removed yet" baseline — filter the all-zero periodic summary.
ORACLE_BASELINE_RE="PVOBS movieBlanked=0 tvEmptied=0"
# PV playback errors surface on the player/exoplayer path; watch the usual crashes.
ERROR_RE="FATAL|SIGABRT|SIGSEGV|has died.*livingroom|ANR in com.amazon.amazonvideo.livingroom|ExoPlaybackException"
