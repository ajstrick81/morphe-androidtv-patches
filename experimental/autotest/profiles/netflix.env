# Netflix (patched clone) — autotest profile.
# Prereqs: clone installed + logged in; STOCK Netflix enabled (clone reads its
# signature). The bundled gadget self-logs the KILL/OBS oracle — no frida attach.
PKG=com.netflix.ninja.clone
ACT=com.netflix.ninja.clone/com.netflix.ninja.MainActivity
LAUNCH=monkey
RESUME_KEYS="DPAD_CENTER DPAD_CENTER"
# Proof the in-process ad kills applied at launch.
ARMED_RE="KILL.*apply DONE"
# The read-only oracle line the kill script emits every few seconds.
ORACLE_RE="OBS[0-9]+: KILLMARK=[0-9]+ rawRealPods=[0-9]+ rawDisplayAd=[0-9]+.*"
# "Nothing happened" baseline: KILLMARK 0/1 and no raw pods/display ads.
ORACLE_BASELINE_RE="KILLMARK=[01] rawRealPods=0 rawDisplayAd=0"
ERROR_RE="tvq-pb|FATAL|has died.*clone|SIGABRT|ANR in com.netflix.ninja.clone"
