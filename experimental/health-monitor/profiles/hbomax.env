# HBO Max (com.wbd.hbomax) — Health Monitor profile.
#
# Validates the v1.29.3 default-ON "Block SSAI Ad Origins" fix (issue #125):
# long-haul playback should stay ad-free and continuous. The origin guard throws
# an IOException on -free.prd.media.max.com so HBO's resiliency layer falls back
# to the clean manifest; the Bolt patch empties nonlinear ad requests. Both leave
# a healthy logcat signature we count as SUPPRESS_RE. Verified this way ~36 min
# across Conan / A Minecraft Movie / A Long Walk on the Onn 4K (.211).
PKG=com.wbd.hbomax

# BeamActivity resolves under LEANBACK_LAUNCHER, so monkey/auto-resolve works.
LAUNCH=monkey
ACT=com.wbd.hbomax/com.wbd.beam.BeamActivity

# From the app's landing screen the featured/continue tile is focused; one CENTER
# opens details, a second starts playback. Verify by hand once per major version.
RESUME_KEYS="DPAD_CENTER DPAD_CENTER"

# Rotation: HBO Max ATV deep links are not yet verified on-device, so this profile
# ships in single-title mode. To enable rotation, capture real VIEW-intent deep
# links (observe `am start` in logcat while opening titles by hand) and list them:
#TITLES="
#  <deep-link-to-title-1>
#  <deep-link-to-title-2>
#"
# Until then, for multi-title coverage run with LAUNCH=attach and switch titles by
# hand every ~18m, or re-run per title.
ROTATE_MIN=18
TICK_SECS=30

# Exercise the resume/seek seams every ~5 min: HBO can re-request the ad-stitched
# manifest on resume, and a seek can land in an SSAI ad period — both are where a
# leak would reappear. BACK from the player returns to the title detail; the two
# CENTER RESUME_KEYS resume playback; then fast-forward. Set 0 to disable.
STRESS_EVERY_MIN=5
SEEK_KEYS="MEDIA_FAST_FORWARD MEDIA_FAST_FORWARD"

# media_session publishes an advancing position during playback.
PLAYBACK_PROBE=position

# HEALTHY defense signatures: the Prefer-Ad-Free-Stream remap picking HBO's ad-free
# FALLBACK manifest, and the Bolt nonlinear-ad request coming back empty.
SUPPRESS_RE="remapping PRIMARY -> FALLBACK|ad origin blocked|Bolt::Model::Response: Could not parse"

# A 39999 / ws2 FATAL / a -free ad-segment request means the ad-free stream was
# NOT used (the exact regression we are validating against) — treat as a hard leak.
AD_LEAK_RE="39999|@@FATAL@@|-free\.prd\.media\.max\.com|Couldn't Play"

# You.i/ExoPlayer stack: catch native crashes, ANRs, and playback faults.
ERROR_RE="FATAL|ANR in com.wbd.hbomax|SIGABRT|SIGSEGV|has died|ExoPlaybackException"

SERIAL=192.168.12.211:5555
