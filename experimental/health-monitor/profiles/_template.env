# Copy this to <yourapp>.env and fill in. Only PKG is strictly required.
# Health Monitor = long-duration ad-free + continuity babysitter. See ../README.md.

# PKG        installed (patched) package name.                          [required]
PKG=com.example.app

# LAUNCH     "monkey" (open from launcher, default) OR "attach" (monitor content
#            you have ALREADY started playing by hand — no launch, no rotation).
#            Use attach for apps with no safe blind-resume entry.
LAUNCH=monkey

# ACT        explicit "pkg/activity" launch component. Leave unset to resolve the
#            leanback launcher activity automatically.
#ACT=com.example.app/.MainActivity

# RESUME_KEYS keyevents (no KEYCODE_ prefix) to START playback after a launch or a
#            title switch. Default assumes a Continue-Watching / play tile is
#            focused. NEVER add open-ended DPAD sweeps — the TV can't be seen.
RESUME_KEYS="DPAD_CENTER DPAD_CENTER"

# TITLES     deep links to ROTATE through (one per line or space-separated), each
#            an `am start -a VIEW -d <url>` target. This is the ONLY safe rotation
#            vector. Empty = single-title mode (no rotation). Find real deep links
#            per app (adb shell dumpsys package <PKG> | grep -i scheme, or observe
#            `am start` intents in logcat while opening a title by hand).
#TITLES="
#  https://play.example.com/movie/aaaa
#  https://play.example.com/movie/bbbb
#  example://title/cccc
#"

# ROTATE_MIN minutes per title before switching (default 18). TICK_SECS = seconds
#            between health snapshots (default 30).
ROTATE_MIN=18
TICK_SECS=30

# STRESS_EVERY_MIN  every N minutes, run a play -> BACK -> resume -> seek -> play
#            cycle to exercise the resume/seek seams where ad re-insertion hides
#            (a fresh manifest/ad-decision on resume, or a seek landing in an ad
#            period). 0 = off. Uses media keys + RESUME_KEYS only, foreground-
#            guarded — no blind nav. SEEK_KEYS = the fast-forward beat.
STRESS_EVERY_MIN=0
SEEK_KEYS="MEDIA_FAST_FORWARD MEDIA_FAST_FORWARD"

# PLAYBACK_PROBE "position" (require advancing position, default) | "state" (some
#            native players pin position at 0 but publish state=PLAYING).
PLAYBACK_PROBE=position

# SUPPRESS_RE logcat regex for HEALTHY ad-defense activity (guard fired / empty ad
#            response). Informational — counted per tick, not an alert.
SUPPRESS_RE=""

# AD_LEAK_RE logcat regex that must NEVER appear (a real ad rendering / ad-timeline
#            being built). A match raises a hard ALERT.
AD_LEAK_RE=""

# ERROR_RE   crash/ANR/playback-error regex. Sensible default applied if unset:
#            "FATAL|ANR in <PKG>|SIGABRT|SIGSEGV|has died|ExoPlaybackException".
#ERROR_RE="FATAL|SIGABRT|SIGSEGV|has died|ExoPlaybackException"

# SERIAL     adb serial if multiple devices are attached (else the single device).
#SERIAL=192.168.12.211:5555
