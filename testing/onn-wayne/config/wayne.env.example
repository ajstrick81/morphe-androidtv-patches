# ── onn 4K Streaming Stick (2026) / wayne / RTD1325 ──────────────────
# Copy to wayne.env and fill in. wayne.env is gitignored.
#
#   cp config/wayne.env.example config/wayne.env

# The stick's IP on your Flint 2 / AdGuard Home network.
# A DHCP reservation keeps this stable across the two factory resets this
# process puts you through.
DEVICE_IP="192.168.1.100"

# Wireless-debugging CONNECT port — NOT the pairing port, and it changes on
# every reboot. ./onn.sh pair --reconnect rewrites this line for you.
ADB_PORT=""

# Set only if the stick ever presents a real USB ADB serial (see
# scripts/08-usb-adb.sh). When set, it overrides the Wi-Fi target.
ADB_SERIAL=""

# Magisk APK — official releases page only. v30.7 is what the guides used.
# Must contain lib/armeabi-v7a: this stick is 32-bit and arm64 binaries fail
# silently.
MAGISK_APK="images/Magisk-v30.7.apk"
