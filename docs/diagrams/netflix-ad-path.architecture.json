        "id": "why-in-heap",
        "label": "Why in-heap",
        "focus": [
          "oca",
          "msl",
          "js",
          "getad",
          "screen"
        ],
        "note": "TLS, MSL and the appboot signature are load-time gates. The manifest decrypts in-process, so ad data and code are plaintext in the heap."
      },
      {
        "id": "the-kill",
        "label": "The kill",
        "focus": [
          "js",
          "getad",
          "gadget",
          "screen"
        ],
        "note": "MASTER: getAdMetadata builds every break. if(d)->if(0), else return->else b=[] — the server's own empty-break shape, played cleanly."
      },
      {
        "id": "clone-gate",
        "label": "Clone + tamper",
        "focus": [
          "stock",
          "clone",
          "gadget",
          "js"
        ],
        "note": "The clone runs only past DexGuard CertCheck and native RJni_SignatureCheck (<queries> reads stock's signature). Keep stock installed."
      },
      {
        "id": "drift",
        "label": "Drift + fallback",
        "focus": [
          "oca",
          "js",
          "getad",
          "gadget"
        ],
        "note": "Ad logic is downloaded JS, re-minified server-side (#166). Wildcard MASTERw/ADVw re-anchor by stable tokens; <<<DRIFT alarms on a miss."
      }
    ]
